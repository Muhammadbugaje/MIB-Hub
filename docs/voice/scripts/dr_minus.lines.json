{
 "character": "Dr. Minus",
 "sections": [
  {
   "section": "Mission 1",
   "title": "Point of Order",
   "file": "Dr. Minus - Mission 1",
   "lines": [
    {
     "n": 1,
     "id": "m031_mid2_01",
     "text": "Has our visiting fellow anything to add?"
    },
    {
     "n": 2,
     "id": "m031_mid2_02",
     "text": "…Minus two. For the bench."
    },
    {
     "n": 3,
     "id": "m031_close_02",
     "text": "Minus two, Miss Nusaiba. For confidence."
    }
   ]
  },
  {
   "section": "Mission 2",
   "title": "The Hearing",
   "file": "Dr. Minus - Mission 2",
   "lines": [
    {
     "n": 1,
     "id": "m046_open_04",
     "text": "They do not. I checked them last night."
    },
    {
     "n": 2,
     "id": "m046_mid1_06",
     "text": "The argument is sound."
    },
    {
     "n": 3,
     "id": "m046_mid1_07",
     "text": "It was sound in my court in week seven. I marked it down."
    },
    {
     "n": 4,
     "id": "m046_mid1_08",
     "text": "For the student."
    }
   ]
  },
  {
   "section": "Mission 3",
   "title": "Padlock Receipts",
   "file": "Dr. Minus - Mission 3",
   "lines": [
    {
     "n": 1,
     "id": "m068_mid2_01",
     "text": "Page two. Minus one comma."
    },
    {
     "n": 2,
     "id": "m068_mid2_02",
     "text": "It is competent. Do not let it go to your head."
    }
   ]
  },
  {
   "section": "Mission 4",
   "title": "Manifesto",
   "file": "Dr. Minus - Mission 4",
   "lines": [
    {
     "n": 1,
     "id": "m079_mid1_01",
     "text": "I trust this hobby will not affect my course."
    },
    {
     "n": 2,
     "id": "m079_mid1_04",
     "text": "Minus two."
    }
   ]
  },
  {
   "section": "Mission 5",
   "title": "Election Day",
   "file": "Dr. Minus - Mission 5",
   "lines": [
    {
     "n": 1,
     "id": "m085_close_01",
     "text": "Congratulations. Your examination is in May."
    }
   ]
  },
  {
   "section": "Mission 6",
   "title": "The Missing Script",
   "file": "Dr. Minus - Mission 6",
   "lines": [
    {
     "n": 1,
     "id": "m100_mid2_02",
     "text": "I marked it. It is the best script in nineteen years."
    },
    {
     "n": 2,
     "id": "m100_mid2_03",
     "text": "I could not record that mark for one who argues with me."
    },
    {
     "n": 3,
     "id": "m100_mid2_04",
     "text": "I was failed that way once. I called it standards."
    },
    {
     "n": 4,
     "id": "m100_close_01",
     "text": "Plus two. For conduct."
    }
   ]
  },
  {
   "section": "Common 1",
   "title": "Saying hello",
   "file": "Dr. Minus - Common 1",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_greet_01",
     "text": "Good morning. You may proceed. No marks either way."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_greet_02",
     "text": "Ah. A student. Walking on my side of the corridor. Minus one."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_f_greet_03",
     "text": "You greeted me first. Plus nothing. Manners are expected."
    }
   ]
  },
  {
   "section": "Common 2",
   "title": "Saying goodbye",
   "file": "Dr. Minus - Common 2",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_bye_01",
     "text": "Go. Promptly. Promptness is unmarked, which is a mercy."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_bye_02",
     "text": "Good day. Do not run. Running is an argument with time."
    }
   ]
  },
  {
   "section": "Common 3",
   "title": "Thank-yous and sorries",
   "file": "Dr. Minus - Common 3",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_thanks_01",
     "text": "Thank you. Plus half. I have rounded it down."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_sorry_01",
     "text": "An apology. Noted. The deduction stands, but noted."
    }
   ]
  },
  {
   "section": "Common 4",
   "title": "Being nice",
   "file": "Dr. Minus - Common 4",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_compliment_01",
     "text": "That was competent. Do not let it go to your head."
    }
   ]
  },
  {
   "section": "Common 5",
   "title": "Teasing",
   "file": "Dr. Minus - Common 5",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_tease_01",
     "text": "Your shirt is untucked. Not a deduction. An observation."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_tease_02",
     "text": "You used 'basically'. Basically, minus one."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_f_tease_03",
     "text": "Your handwriting has the confidence of a man at a buffet. Minus one."
    }
   ]
  },
  {
   "section": "Common 6",
   "title": "Quick answers",
   "file": "Dr. Minus - Common 6",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_yes_01",
     "text": "Yes. Subject to conditions."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_no_01",
     "text": "No. Objection overruled. By me."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_f_confused_01",
     "text": "I do not follow. Neither, I suspect, do you."
    }
   ]
  },
  {
   "section": "Common 7",
   "title": "Jokes and questions",
   "file": "Dr. Minus - Common 7",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_ask_01",
     "text": "A question? Minus two. Very well, ask it. It may be worth it."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_ask_02",
     "text": "Did you cite your source? A friend is not a source."
    }
   ]
  },
  {
   "section": "Common 8",
   "title": "When something goes wrong",
   "file": "Dr. Minus - Common 8",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_hit_01",
     "text": "Collision. Minus one. Each."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_blackout_01",
     "text": "The light is gone. The deductions remain."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_f_light_back_01",
     "text": "Light. Nobody cheer. Cheering is minus one."
    },
    {
     "n": 4,
     "id": "bk_dr_minus_f_rain_01",
     "text": "Rain. Wet scripts. I mark them anyway."
    }
   ]
  },
  {
   "section": "Common 9",
   "title": "Getting a present",
   "file": "Dr. Minus - Common 9",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_gift_like_01",
     "text": "A red pen. Practical. Plus one. Do not tell anyone."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_gift_dislike_01",
     "text": "Flowers. For me? Irrelevant to the course. Thank you."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_f_gift_love_01",
     "text": "An old casebook. First edition. I… thank you. Truly."
    }
   ]
  },
  {
   "section": "Common 10",
   "title": "Talking to yourself",
   "file": "Dr. Minus - Common 10",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_f_idle_01",
     "text": "Page two. Minus one comma. Page three. Minus two commas."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_f_idle_02",
     "text": "Nineteen years. Every script says 'in a nutshell'. No nuts. No shells."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_f_idle_03",
     "text": "Standards are standards. Someone must keep them in a drawer."
    }
   ]
  },
  {
   "section": "Common 11",
   "title": "Year 1: arriving",
   "file": "Dr. Minus - Common 11",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_y1_idle_01",
     "text": "Freshers who say 'objection' in the corridor. Minus two for drama."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_y1_tease_01",
     "text": "Not a Law student? Then I cannot deduct. How restful for you."
    }
   ]
  },
  {
   "section": "Common 12",
   "title": "Year 2: the mall",
   "file": "Dr. Minus - Common 12",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_y2_callback_01",
     "text": "Your friend the visiting fellow. The bench remembers."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_y2_idle_01",
     "text": "Miss Nusaiba is confident again. I have prepared deductions."
    }
   ]
  },
  {
   "section": "Common 13",
   "title": "Year 3: the strike",
   "file": "Dr. Minus - Common 13",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_y3_ev_strike_01",
     "text": "The strike. Nobody to deduct. I deduct the pigeons."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_y3_ev_strike_02",
     "text": "I mark old scripts again. They still have the same commas."
    }
   ]
  },
  {
   "section": "Common 14",
   "title": "Year 4: fame",
   "file": "Dr. Minus - Common 14",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_y4_idle_01",
     "text": "A video about me. Grainy. Minus two for lighting."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_y4_ev_elections_01",
     "text": "A manifesto with no full stops. I have deducted it on principle."
    }
   ]
  },
  {
   "section": "Common 15",
   "title": "Year 5: leaving",
   "file": "Dr. Minus - Common 15",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_y5_idle_01",
     "text": "Plus two. I have been practising. It is harder to say."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_y5_idle_02",
     "text": "The best script in nineteen years. I keep it in my drawer."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_y5_compliment_01",
     "text": "Good. Plus one. Do not make a habit of my generosity."
    }
   ]
  },
  {
   "section": "Common 16",
   "title": "Special days: term time",
   "file": "Dr. Minus - Common 16",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_ev_ev_freshers_01",
     "text": "Freshers. So many questions. So few marks to deduct from."
    },
    {
     "n": 2,
     "id": "bk_dr_minus_ev_ev_exam_01",
     "text": "Write in ink. Pencil is for people who intend to change."
    },
    {
     "n": 3,
     "id": "bk_dr_minus_ev_ev_exam_02",
     "text": "Exam week. My red pen has been sharpened. Spiritually."
    },
    {
     "n": 4,
     "id": "bk_dr_minus_ev_ev_results_01",
     "text": "The mark is the mark. What you do next is unmarked."
    }
   ]
  },
  {
   "section": "Common 17",
   "title": "Special days: the big ones",
   "file": "Dr. Minus - Common 17",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_ev_ev_convocation_01",
     "text": "They graduate. I have nobody to deduct from until September."
    }
   ]
  },
  {
   "section": "Common 18",
   "title": "Special days: seasons and holidays",
   "file": "Dr. Minus - Common 18",
   "lines": [
    {
     "n": 1,
     "id": "bk_dr_minus_ev_ev_valentine_01",
     "text": "Red everywhere. Like my pen. Coincidence."
    }
   ]
  }
 ],
 "pending": []
}
