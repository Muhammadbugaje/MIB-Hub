{
 "character": "Mama Nkechi",
 "sections": [
  {
   "section": "Mission 1",
   "title": "Belle First",
   "file": "Mama Nkechi - Mission 1",
   "lines": [
    {
     "n": 1,
     "id": "m003_open_01",
     "text": "Fry the tomato till it stops shouting."
    },
    {
     "n": 2,
     "id": "m003_open_02",
     "text": "Add water early and I will know."
    }
   ]
  },
  {
   "section": "Mission 2",
   "title": "Love in the Time of NEPA",
   "file": "Mama Nkechi - Mission 2",
   "lines": [
    {
     "n": 1,
     "id": "m040_mid1_02",
     "text": "Sapa stew. It is mostly confidence."
    },
    {
     "n": 2,
     "id": "m040_mid1_03",
     "text": "One onion. One tomato. One cube. And don't be proud."
    },
    {
     "n": 3,
     "id": "m040_mid1_04",
     "text": "You have eaten today? Don't lie to me."
    }
   ]
  },
  {
   "section": "Mission 3",
   "title": "Those Who Stayed",
   "file": "Mama Nkechi - Mission 3",
   "lines": [
    {
     "n": 1,
     "id": "m051_close_01",
     "text": "You have eaten? Don't lie to me."
    }
   ]
  },
  {
   "section": "Mission 4",
   "title": "Garri Economics",
   "file": "Mama Nkechi - Mission 4",
   "lines": [
    {
     "n": 1,
     "id": "m052_mid1_01",
     "text": "So you are feeding my customers sand and sugar."
    },
    {
     "n": 2,
     "id": "m052_mid1_03",
     "text": "Light your stove. Let them taste and judge."
    }
   ]
  },
  {
   "section": "Mission 5",
   "title": "Cancelled",
   "file": "Mama Nkechi - Mission 5",
   "lines": [
    {
     "n": 1,
     "id": "m082_mid1_04",
     "text": "I have seen you eat."
    },
    {
     "n": 2,
     "id": "m082_mid1_05",
     "text": "Person wey chop like that no fit keep secret. Sit."
    }
   ]
  },
  {
   "section": "Mission 6",
   "title": "Cook-Off",
   "file": "Mama Nkechi - Mission 6",
   "lines": [
    {
     "n": 1,
     "id": "m089_open_01",
     "text": "You have eaten? Don't lie to me."
    },
    {
     "n": 2,
     "id": "m089_open_02",
     "text": "Good. You will need it. Three hundred plates."
    },
    {
     "n": 3,
     "id": "m089_close_04",
     "text": "The real one. Not the one I show people."
    },
    {
     "n": 4,
     "id": "m089_close_05",
     "text": "Everybody was a student once. Carry the pot."
    }
   ]
  },
  {
   "section": "Common 1",
   "title": "Saying hello",
   "file": "Mama Nkechi - Common 1",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_greet_01",
     "text": "You have eaten? Don't lie to me."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_greet_02",
     "text": "Nwa m! [My child!] Sit. The rice is just ready."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_f_greet_03",
     "text": "Bia! [Come!] Why your face be like Monday morning?"
    },
    {
     "n": 4,
     "id": "bk_mama_nkechi_f_greet_04",
     "text": "Ehen. Hunger brought you. Not love. I know."
    }
   ]
  },
  {
   "section": "Common 2",
   "title": "Saying goodbye",
   "file": "Mama Nkechi - Common 2",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_bye_01",
     "text": "Go well. Come back before you faint, not after."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_bye_02",
     "text": "Take this nylon of meat. Don't argue. Go."
    }
   ]
  },
  {
   "section": "Common 3",
   "title": "Thank-yous and sorries",
   "file": "Mama Nkechi - Common 3",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_thanks_01",
     "text": "Thank God, not me. Then pay me."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_sorry_01",
     "text": "Ndo. [Sorry.] Food first. Then cry. In that order."
    }
   ]
  },
  {
   "section": "Common 4",
   "title": "Teasing",
   "file": "Mama Nkechi - Common 4",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_tease_01",
     "text": "You are getting thin. Is it love or sapa? Both?"
    }
   ]
  },
  {
   "section": "Common 5",
   "title": "Quick answers",
   "file": "Mama Nkechi - Common 5",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_refuse_01",
     "text": "You will not leave half. Children are hungry somewhere. You."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_no_01",
     "text": "No. Spaghetti is not soup."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_f_confused_01",
     "text": "Who? There was nobody there fa. Only you and your hunger."
    }
   ]
  },
  {
   "section": "Common 6",
   "title": "When something goes wrong",
   "file": "Mama Nkechi - Common 6",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_blackout_01",
     "text": "Light don go? [Power's gone?] Firewood never fails. Sit."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_rain_01",
     "text": "Rain! Pepper soup weather. God is good."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_f_heat_01",
     "text": "Heat? You think the pot is enjoying itself?"
    },
    {
     "n": 4,
     "id": "bk_mama_nkechi_f_hit_01",
     "text": "Mind the pot! Hot soup does not apologise!"
    }
   ]
  },
  {
   "section": "Common 7",
   "title": "Food and money",
   "file": "Mama Nkechi - Common 7",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_money_01",
     "text": "Credit? Your name is in the book. Page six. It is a long page."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_money_02",
     "text": "No money? Eat. The book is patient. I am less."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_f_money_03",
     "text": "Meat is extra. Fish is extra. Your attitude is extra."
    },
    {
     "n": 4,
     "id": "bk_mama_nkechi_f_food_01",
     "text": "Fry the tomato till it stops shouting."
    },
    {
     "n": 5,
     "id": "bk_mama_nkechi_f_food_02",
     "text": "Small chop? This is a buka. Everything here is big chop."
    },
    {
     "n": 6,
     "id": "bk_mama_nkechi_f_food_03",
     "text": "Add water early and I will know. I always know."
    }
   ]
  },
  {
   "section": "Common 8",
   "title": "Getting a present",
   "file": "Mama Nkechi - Common 8",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_gift_like_01",
     "text": "Crayfish! Who taught you sense?"
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_gift_dislike_01",
     "text": "Cube from the mall? With English on it? Hm. Thank you."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_f_gift_love_01",
     "text": "A new pot. Chineke! [My God!] I will name it after you."
    }
   ]
  },
  {
   "section": "Common 9",
   "title": "Talking to yourself",
   "file": "Mama Nkechi - Common 9",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_idle_01",
     "text": "Who carried my ladle? Ladle no get leg!"
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_f_idle_02",
     "text": "Thirty years of students. Their stomachs never graduate."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_f_idle_03",
     "text": "Onions have gone up again. I am crying for two reasons."
    }
   ]
  },
  {
   "section": "Common 10",
   "title": "Late at night",
   "file": "Mama Nkechi - Common 10",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_f_night_01",
     "text": "Last pot. Come and scrape it before the cats do."
    }
   ]
  },
  {
   "section": "Common 11",
   "title": "Year 1: arriving",
   "file": "Mama Nkechi - Common 11",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_y1_greet_01",
     "text": "Fresher! First meal is a welcome. Second meal is business."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_y1_food_01",
     "text": "Belle first. Then the lecture. The lecture does not feed you."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_y1_tease_01",
     "text": "Your mother called you? Good. Did you tell her about my rice?"
    }
   ]
  },
  {
   "section": "Common 12",
   "title": "Year 2: the mall",
   "file": "Mama Nkechi - Common 12",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_y2_food_01",
     "text": "Sapa stew. It is mostly confidence."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_y2_idle_01",
     "text": "The mall food court. Plates like coins. Come back when hungry."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_y2_money_01",
     "text": "Allowance late? I know. I can see it in your neck."
    }
   ]
  },
  {
   "section": "Common 13",
   "title": "Year 3: the strike",
   "file": "Mama Nkechi - Common 13",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_y3_idle_01",
     "text": "Strike or no strike, the pot is on. Who stayed, eats."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_y3_idle_02",
     "text": "Garri and sugar again? Bia. Come and eat food."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_y3_callback_01",
     "text": "Your friend's garri. Sand and sugar. He is forgiven. Barely."
    }
   ]
  },
  {
   "section": "Common 14",
   "title": "Year 4: fame",
   "file": "Mama Nkechi - Common 14",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_y4_idle_01",
     "text": "You are famous? Famous people also chop. Sit."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_y4_callback_01",
     "text": "Three hundred plates. Not one came back. Not one."
    }
   ]
  },
  {
   "section": "Common 15",
   "title": "Year 5: leaving",
   "file": "Mama Nkechi - Common 15",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_y5_idle_01",
     "text": "Final year. I am cooking slower. Maybe you will stay longer."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_y5_idle_02",
     "text": "Your page in the book. I tore it out. Don't tell anybody."
    }
   ]
  },
  {
   "section": "Common 16",
   "title": "After graduation",
   "file": "Mama Nkechi - Common 16",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_post_greet_01",
     "text": "Senior! You came back. You have eaten? Don't lie to me."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_post_idle_01",
     "text": "The new ones eat like you did. Like a hungry tax collector."
    }
   ]
  },
  {
   "section": "Common 17",
   "title": "Special days: term time",
   "file": "Mama Nkechi - Common 17",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_ev_ev_freshers_01",
     "text": "New faces, new stomachs. Let them come."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_ev_ev_exam_01",
     "text": "Exam week. You eat before you read. Brain needs rice."
    },
    {
     "n": 3,
     "id": "bk_mama_nkechi_ev_ev_allowance_01",
     "text": "Allowance day. Now you remember the book. Page six."
    }
   ]
  },
  {
   "section": "Common 18",
   "title": "Special days: the big ones",
   "file": "Mama Nkechi - Common 18",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_ev_ev_strike_01",
     "text": "They closed the school. They did not close my pot."
    }
   ]
  },
  {
   "section": "Common 19",
   "title": "Special days: seasons and holidays",
   "file": "Mama Nkechi - Common 19",
   "lines": [
    {
     "n": 1,
     "id": "bk_mama_nkechi_ev_ev_ramadan_01",
     "text": "Ramadan Kareem. Pap and akara at sunset. I saved you some."
    },
    {
     "n": 2,
     "id": "bk_mama_nkechi_ev_ev_christmas_01",
     "text": "Jollof for Christmas! Going home? Take some for the road."
    }
   ]
  }
 ],
 "pending": []
}
