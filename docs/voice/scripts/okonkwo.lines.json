{
 "character": "Dr. Okonkwo",
 "sections": [
  {
   "section": "Mission 1",
   "title": "First Lecture, Wrong Theatre",
   "file": "Dr. Okonkwo - Mission 1",
   "lines": [
    {
     "n": 1,
     "id": "m005_mid1_06",
     "text": "Sit in front, Nusaiba. I need the supervision."
    },
    {
     "n": 2,
     "id": "m005_close_02",
     "text": "Page forty is not on the syllabus."
    },
    {
     "n": 3,
     "id": "m005_close_03",
     "text": "Neither is asking."
    }
   ]
  },
  {
   "section": "Mission 2",
   "title": "Six Plaques",
   "file": "Dr. Okonkwo - Mission 2",
   "lines": [
    {
     "n": 1,
     "id": "m020_close_01",
     "text": "Six sites. One ring. We have one."
    }
   ]
  },
  {
   "section": "Mission 3",
   "title": "Mubarak's Crash",
   "file": "Dr. Okonkwo - Mission 3",
   "lines": [
    {
     "n": 1,
     "id": "m045_open_02",
     "text": "That is thermal runaway."
    },
    {
     "n": 2,
     "id": "m045_open_03",
     "text": "It will be in the exam."
    }
   ]
  },
  {
   "section": "Mission 4",
   "title": "Three Hundred",
   "file": "Dr. Okonkwo - Mission 4",
   "lines": [
    {
     "n": 1,
     "id": "m049_close_01",
     "text": "Three names, one thumbs-up. I have seen worse."
    },
    {
     "n": 2,
     "id": "m049_close_02",
     "text": "Work fast. The staff union is having meetings."
    },
    {
     "n": 3,
     "id": "m049_close_03",
     "text": "Page forty."
    }
   ]
  },
  {
   "section": "Mission 5",
   "title": "Lights on the Long Road",
   "file": "Dr. Okonkwo - Mission 5",
   "lines": [
    {
     "n": 1,
     "id": "m072_mid1_02",
     "text": "Madam, it is a lamp."
    },
    {
     "n": 2,
     "id": "m072_mid1_06",
     "text": "Adequate. Which from me is poetry."
    }
   ]
  },
  {
   "section": "Mission 6",
   "title": "Nationals",
   "file": "Dr. Okonkwo - Mission 6",
   "lines": [
    {
     "n": 1,
     "id": "m087_close_07",
     "text": "Best Engineering Design. That's the real one."
    }
   ]
  },
  {
   "section": "Mission 7",
   "title": "Log Off",
   "file": "Dr. Okonkwo - Mission 7",
   "lines": [
    {
     "n": 1,
     "id": "m095_open_04",
     "text": "To the diagram. Show us the great deal."
    }
   ]
  },
  {
   "section": "Mission 8",
   "title": "The Maker's Notebook",
   "file": "Dr. Okonkwo - Mission 8",
   "lines": [
    {
     "n": 1,
     "id": "m098_close_01",
     "text": "Page forty-one is not on the syllabus either."
    }
   ]
  },
  {
   "section": "Mission 9",
   "title": "Build Week",
   "file": "Dr. Okonkwo - Mission 9",
   "lines": [
    {
     "n": 1,
     "id": "m104_mid1_01",
     "text": "Margins."
    }
   ]
  },
  {
   "section": "Mission 10",
   "title": "Everybody, Again",
   "file": "Dr. Okonkwo - Mission 10",
   "lines": [
    {
     "n": 1,
     "id": "m106_open_01",
     "text": "I was in Yamma. Do not write that down."
    }
   ]
  },
  {
   "section": "Mission 11",
   "title": "Project Defence",
   "file": "Dr. Okonkwo - Mission 11",
   "lines": [
    {
     "n": 1,
     "id": "m110_open_01",
     "text": "Use your finger. Nobody ever failed for being brief."
    },
    {
     "n": 2,
     "id": "m110_close_04",
     "text": "Page forty."
    }
   ]
  },
  {
   "section": "Common 1",
   "title": "Saying hello",
   "file": "Dr. Okonkwo - Common 1",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_greet_01",
     "text": "Good morning. You look like someone who read. Prove me right."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_greet_02",
     "text": "Ah. One of mine. Walk faster, you're late for something."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_f_greet_03",
     "text": "Kedu? [How are you?] Don't answer. Page forty."
    },
    {
     "n": 4,
     "id": "bk_okonkwo_f_greet_04",
     "text": "You again. The universe is consistent, at least."
    }
   ]
  },
  {
   "section": "Common 2",
   "title": "Saying goodbye",
   "file": "Dr. Okonkwo - Common 2",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_bye_01",
     "text": "Go. And close that door like an engineer. Gently."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_bye_02",
     "text": "Good. Off you go. Read something."
    }
   ]
  },
  {
   "section": "Common 3",
   "title": "Thank-yous and sorries",
   "file": "Dr. Okonkwo - Common 3",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_thanks_01",
     "text": "Thank you. I'll pretend I'm not surprised."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_thanks_02",
     "text": "Thank you. That was… adequate. I mean it kindly."
    }
   ]
  },
  {
   "section": "Common 4",
   "title": "Being nice",
   "file": "Dr. Okonkwo - Common 4",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_compliment_01",
     "text": "Clean working. Who are you and what have you done?"
    }
   ]
  },
  {
   "section": "Common 5",
   "title": "Teasing",
   "file": "Dr. Okonkwo - Common 5",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_tease_01",
     "text": "Your diagram has a current going nowhere. Like your weekend."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_tease_02",
     "text": "You wrote 'approximately infinity'. Bold. Wrong, but bold."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_f_tease_03",
     "text": "Theatre Yamma is the other one. You'll learn. Everyone does."
    }
   ]
  },
  {
   "section": "Common 6",
   "title": "Quick answers",
   "file": "Dr. Okonkwo - Common 6",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_yes_01",
     "text": "Yes. Briefly."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_no_01",
     "text": "No. But I admire the attempt."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_f_confused_01",
     "text": "Start again. Slowly. Like the question is a resistor."
    }
   ]
  },
  {
   "section": "Common 7",
   "title": "Jokes and questions",
   "file": "Dr. Okonkwo - Common 7",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_ask_01",
     "text": "Units. Where are your units? Did they travel?"
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_ask_02",
     "text": "Have you read page forty? Don't lie. I can hear lying."
    }
   ]
  },
  {
   "section": "Common 8",
   "title": "When something goes wrong",
   "file": "Dr. Okonkwo - Common 8",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_hit_01",
     "text": "Eyes up. A circuit can't be read from the floor."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_blackout_01",
     "text": "There goes the light. Note the time. It's data."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_f_blackout_02",
     "text": "Everybody stay seated. Nobody's notes are worth tripping for."
    },
    {
     "n": 4,
     "id": "bk_okonkwo_f_light_back_01",
     "text": "Light. Stop cheering, it's not your doing. Yet."
    },
    {
     "n": 5,
     "id": "bk_okonkwo_f_heat_01",
     "text": "This room is a thermal experiment and we are the samples."
    }
   ]
  },
  {
   "section": "Common 9",
   "title": "Getting a present",
   "file": "Dr. Okonkwo - Common 9",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_gift_like_01",
     "text": "A good pen. You noticed mine was dying. Observant. Good."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_gift_dislike_01",
     "text": "Thank you. It will live in my drawer, with its cousins."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_f_gift_love_01",
     "text": "A proper multimeter. Don't tell anyone I smiled."
    }
   ]
  },
  {
   "section": "Common 10",
   "title": "Talking to yourself",
   "file": "Dr. Okonkwo - Common 10",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_f_idle_01",
     "text": "Forty scripts. Thirty-nine say 'as shown above'. Above what?"
    },
    {
     "n": 2,
     "id": "bk_okonkwo_f_idle_02",
     "text": "Who keeps borrowing my chalk? I count my chalk."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_f_idle_03",
     "text": "Someone drew a smiley in Ohm's law. It's quite good."
    }
   ]
  },
  {
   "section": "Common 11",
   "title": "Year 1: arriving",
   "file": "Dr. Okonkwo - Common 11",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_y1_idle_01",
     "text": "Every September someone sits in Yamma for my Gabas class."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_y1_idle_02",
     "text": "Freshers. They write so much. Then they learn to write less."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_y1_tease_01",
     "text": "You found the right theatre. Growth."
    },
    {
     "n": 4,
     "id": "bk_okonkwo_y1_ev_exam_01",
     "text": "One lamp, four students. Share the light and the formulas."
    }
   ]
  },
  {
   "section": "Common 12",
   "title": "Year 2: the mall",
   "file": "Dr. Okonkwo - Common 12",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_y2_idle_01",
     "text": "A phone battery exploded in my class. I'm adding it to the exam."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_y2_idle_02",
     "text": "That mall has more light than my lab. Note it. It's data."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_y2_compliment_01",
     "text": "Your tutorial last week. Good. I'm not saying it twice."
    }
   ]
  },
  {
   "section": "Common 13",
   "title": "Year 3: the strike",
   "file": "Dr. Okonkwo - Common 13",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_y3_ev_strike_01",
     "text": "Empty theatre. I lectured the chairs. They took notes."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_y3_ev_strike_02",
     "text": "You're still reading during the strike. Quietly: good."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_y3_idle_01",
     "text": "Meetings about meetings. Then a meeting to plan the meetings."
    }
   ]
  },
  {
   "section": "Common 14",
   "title": "Year 4: fame",
   "file": "Dr. Okonkwo - Common 14",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_y4_idle_01",
     "text": "A video says I'm strict. Only 'strict'? I'm insulted."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_y4_idle_02",
     "text": "Pick your project early. Late picks pick you."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_y4_ask_01",
     "text": "Have you a supervisor yet? Don't look at me like that. …Fine."
    }
   ]
  },
  {
   "section": "Common 15",
   "title": "Year 5: leaving",
   "file": "Dr. Okonkwo - Common 15",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_y5_idle_01",
     "text": "My supervisee. Your margins are wide. Your chapters are not."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_y5_idle_02",
     "text": "Chapter three is good. I wrote 'good'. In ink. Frame it."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_y5_wait_01",
     "text": "Defence in four weeks. Walk like it."
    },
    {
     "n": 4,
     "id": "bk_okonkwo_y5_callback_01",
     "text": "I was in Yamma once too. Still not writing that down."
    }
   ]
  },
  {
   "section": "Common 16",
   "title": "Special days: term time",
   "file": "Dr. Okonkwo - Common 16",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_ev_ev_freshers_01",
     "text": "New faces. Same question: 'Ma, is this Gabas?'"
    },
    {
     "n": 2,
     "id": "bk_okonkwo_ev_ev_exam_01",
     "text": "Read the question twice. Answer it once."
    },
    {
     "n": 3,
     "id": "bk_okonkwo_ev_ev_exam_02",
     "text": "No, page forty is not coming out. Probably."
    },
    {
     "n": 4,
     "id": "bk_okonkwo_ev_ev_results_01",
     "text": "Results are a reading, not a verdict. Adjust and continue."
    }
   ]
  },
  {
   "section": "Common 17",
   "title": "Special days: the big ones",
   "file": "Dr. Okonkwo - Common 17",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_ev_ev_cup_01",
     "text": "Engineering won? I'll allow one song. One."
    },
    {
     "n": 2,
     "id": "bk_okonkwo_ev_ev_convocation_01",
     "text": "Gowns. I pretend I don't cry. Watch me pretend."
    }
   ]
  },
  {
   "section": "Common 18",
   "title": "Special days: seasons and holidays",
   "file": "Dr. Okonkwo - Common 18",
   "lines": [
    {
     "n": 1,
     "id": "bk_okonkwo_ev_ev_harmattan_01",
     "text": "Harmattan. Static on every doorknob. Free practical."
    }
   ]
  }
 ],
 "pending": []
}
