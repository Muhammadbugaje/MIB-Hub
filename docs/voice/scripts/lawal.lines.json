{
 "character": "Ranger Lawal",
 "sections": [
  {
   "section": "Mission 1",
   "title": "Baba Dam's Pier",
   "file": "Ranger Lawal - Mission 1",
   "lines": [
    {
     "n": 1,
     "id": "m015_close_02",
     "text": "Go back."
    },
    {
     "n": 2,
     "id": "m015_close_04",
     "text": "…Go back."
    }
   ]
  },
  {
   "section": "Mission 2",
   "title": "Past the Last Streetlight",
   "file": "Ranger Lawal - Mission 2",
   "lines": [
    {
     "n": 1,
     "id": "m055_close_01",
     "text": "I did not show you this."
    },
    {
     "n": 2,
     "id": "m055_close_02",
     "text": "Go back."
    }
   ]
  },
  {
   "section": "Mission 3",
   "title": "Ranger Lawal's Debt",
   "file": "Ranger Lawal - Mission 3",
   "lines": [
    {
     "n": 1,
     "id": "m069_close_03",
     "text": "Follow my light."
    },
    {
     "n": 2,
     "id": "m069_close_04",
     "text": "Sannu, iroko. Good evening, neem."
    },
    {
     "n": 3,
     "id": "m069_close_05",
     "text": "Professor."
    }
   ]
  },
  {
   "section": "Mission 4",
   "title": "The Third Coil Wakes",
   "file": "Ranger Lawal - Mission 4",
   "lines": [
    {
     "n": 1,
     "id": "m070_open_01",
     "text": "This is iroko. Greet it."
    }
   ]
  },
  {
   "section": "Mission 5",
   "title": "Three by Road",
   "file": "Ranger Lawal - Mission 5",
   "lines": [
    {
     "n": 1,
     "id": "m112_close_04",
     "text": "I sang. You heard nothing. Follow my light."
    }
   ]
  },
  {
   "section": "Common 1",
   "title": "Saying hello",
   "file": "Ranger Lawal - Common 1",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_greet_01",
     "text": "Go back."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_greet_02",
     "text": "Sannu. [Hello.] You greeted the trees? Greet them."
    },
    {
     "n": 3,
     "id": "bk_lawal_f_greet_03",
     "text": "You again. The forest has noticed you. So have I."
    }
   ]
  },
  {
   "section": "Common 2",
   "title": "Saying goodbye",
   "file": "Ranger Lawal - Common 2",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_bye_01",
     "text": "Go home before dark. The path is shorter in daylight."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_bye_02",
     "text": "Sai wata rana. [Until another day.] Greet Kaka if you pass."
    }
   ]
  },
  {
   "section": "Common 3",
   "title": "Thank-yous and sorries",
   "file": "Ranger Lawal - Common 3",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_thanks_01",
     "text": "Don't thank me. Thank the path. It held."
    }
   ]
  },
  {
   "section": "Common 4",
   "title": "Teasing",
   "file": "Ranger Lawal - Common 4",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_tease_01",
     "text": "You called me Baba Ranger. I heard. The trees heard."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_tease_02",
     "text": "Loud shoes. Every squirrel in Dajin Kwari knows your name."
    }
   ]
  },
  {
   "section": "Common 5",
   "title": "Walking with the player",
   "file": "Ranger Lawal - Common 5",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_follow_01",
     "text": "Follow my light."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_follow_02",
     "text": "Step where I step. Not near. Where."
    },
    {
     "n": 3,
     "id": "bk_lawal_f_wait_01",
     "text": "Slow is not a problem. Lost is a problem. Keep up."
    },
    {
     "n": 4,
     "id": "bk_lawal_f_lost_01",
     "text": "Not that way. That way is the way back to that way."
    }
   ]
  },
  {
   "section": "Common 6",
   "title": "Quick answers",
   "file": "Ranger Lawal - Common 6",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_yes_01",
     "text": "Yes."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_no_01",
     "text": "No."
    },
    {
     "n": 3,
     "id": "bk_lawal_f_refuse_01",
     "text": "I did not show you this."
    },
    {
     "n": 4,
     "id": "bk_lawal_f_confused_01",
     "text": "Hm. Say it the way you would say it to a tree."
    }
   ]
  },
  {
   "section": "Common 7",
   "title": "Jokes and questions",
   "file": "Ranger Lawal - Common 7",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_ask_01",
     "text": "Did you bring water? The forest doesn't sell any."
    }
   ]
  },
  {
   "section": "Common 8",
   "title": "When something goes wrong",
   "file": "Ranger Lawal - Common 8",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_hit_01",
     "text": "Sit. Breathe. The root didn't mean it."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_rain_01",
     "text": "Rain. The trees are drinking. Be quiet for them."
    },
    {
     "n": 3,
     "id": "bk_lawal_f_heat_01",
     "text": "Sun? Under the neem it's ten degrees kinder."
    }
   ]
  },
  {
   "section": "Common 9",
   "title": "Getting a present",
   "file": "Ranger Lawal - Common 9",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_gift_like_01",
     "text": "Groundnuts from Kaka? …She sent you? Then I must eat them."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_gift_dislike_01",
     "text": "Plastic. In the forest. Take it back with you."
    },
    {
     "n": 3,
     "id": "bk_lawal_f_gift_love_01",
     "text": "A seedling. Iroko. …I'll plant it where my father planted his."
    }
   ]
  },
  {
   "section": "Common 10",
   "title": "Talking to yourself",
   "file": "Ranger Lawal - Common 10",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_idle_01",
     "text": "Sannu, iroko. Good evening, neem."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_idle_02",
     "text": "Somebody cut a branch. Not wind. A cutlass. I'll find them."
    },
    {
     "n": 3,
     "id": "bk_lawal_f_idle_03",
     "text": "Baba Ranger. Baba. I'm thirty-four."
    }
   ]
  },
  {
   "section": "Common 11",
   "title": "Late at night",
   "file": "Ranger Lawal - Common 11",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_f_night_01",
     "text": "The forest is cold tonight. Colder than it should be. Walk."
    },
    {
     "n": 2,
     "id": "bk_lawal_f_night_02",
     "text": "Cold patch ahead. Not ours to fix tonight. Follow my light."
    }
   ]
  },
  {
   "section": "Common 12",
   "title": "Year 1: arriving",
   "file": "Ranger Lawal - Common 12",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_y1_idle_01",
     "text": "Students at the dam at midnight. Every year. Go back."
    },
    {
     "n": 2,
     "id": "bk_lawal_y1_callback_01",
     "text": "That night at the dam. I did not see you. You did not see me."
    }
   ]
  },
  {
   "section": "Common 13",
   "title": "Year 2: the mall",
   "file": "Ranger Lawal - Common 13",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_y2_idle_01",
     "text": "The forest is quieter since the mall lights. Birds don't like it."
    }
   ]
  },
  {
   "section": "Common 14",
   "title": "Year 3: the strike",
   "file": "Ranger Lawal - Common 14",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_y3_ev_strike_01",
     "text": "Strike. Students come to the forest now. Some even greet the trees."
    },
    {
     "n": 2,
     "id": "bk_lawal_y3_idle_01",
     "text": "The Old Site. You know the way now. Don't make me regret it."
    },
    {
     "n": 3,
     "id": "bk_lawal_y3_idle_02",
     "text": "Kaka says you ate first. Good. She likes you. Bad for me."
    }
   ]
  },
  {
   "section": "Common 15",
   "title": "Year 4: fame",
   "file": "Ranger Lawal - Common 15",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_y4_idle_01",
     "text": "No filming the forest. The trees didn't agree to it."
    }
   ]
  },
  {
   "section": "Common 16",
   "title": "Year 5: leaving",
   "file": "Ranger Lawal - Common 16",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_y5_idle_01",
     "text": "Follow my light. Last time, maybe. Then follow your own."
    },
    {
     "n": 2,
     "id": "bk_lawal_y5_idle_02",
     "text": "You can call me Baba Ranger. Once. Today only."
    }
   ]
  },
  {
   "section": "Common 17",
   "title": "Special days: term time",
   "file": "Ranger Lawal - Common 17",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_ev_ev_freshers_01",
     "text": "New faces at the forest edge. Go back. All of you. Go back."
    },
    {
     "n": 2,
     "id": "bk_lawal_ev_ev_market_day_01",
     "text": "Market day. Someone is selling 'forest honey'. It's sugar."
    }
   ]
  },
  {
   "section": "Common 18",
   "title": "Special days: seasons and holidays",
   "file": "Ranger Lawal - Common 18",
   "lines": [
    {
     "n": 1,
     "id": "bk_lawal_ev_ev_ramadan_01",
     "text": "Iftar at Kaka's. Come. She cooks for twenty and expects thirty."
    },
    {
     "n": 2,
     "id": "bk_lawal_ev_ev_christmas_01",
     "text": "Nobody cuts a pine in my forest. We have no pines. Still: nobody."
    },
    {
     "n": 3,
     "id": "bk_lawal_ev_ev_harmattan_01",
     "text": "Harmattan. Dry leaves. No fires near the forest. None."
    }
   ]
  }
 ],
 "pending": []
}
