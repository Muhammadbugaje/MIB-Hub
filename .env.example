# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git: never commit real passwords or secrets.

# --- Site ---
# The address the site runs at (used in emailed links).
SITE_URL=http://localhost:4321

# --- Database ---
# "sqlite" = a local file (development). "d1" = Cloudflare D1 (see docs/DATABASE.md).
DATABASE_DRIVER=sqlite
# Relative paths are from the repo root.
DATABASE_FILE=apps/web/.data/dev.sqlite

# --- Accounts (Better Auth) ---
# A long random string, 32+ characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# --- Email ---
# "console" prints emails (password reset links) in the terminal running `npm run dev`.
MAIL_DRIVER=console
MAIL_FROM="MIB-Hub <no-reply@example.com>"

# --- Owner account (created by `npm run db:seed`) ---
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
