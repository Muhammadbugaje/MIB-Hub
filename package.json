{
  "name": "mib-hub",
  "version": "0.1.0",
  "private": true,
  "description": "MIB-Hub: the website that hosts our games (Astro + React + Drizzle + Better Auth).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mib/web",
    "build": "npm run build -w @mib/web",
    "preview": "npm run preview -w @mib/web",
    "db:generate": "npm run db:generate -w @mib/db",
    "db:migrate": "npm run db:migrate -w @mib/db",
    "db:seed": "npm run db:seed -w @mib/web",
    "db:reset": "npm run db:reset -w @mib/db && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/db --noEmit && tsc -p packages/ui --noEmit && npm run typecheck -w @mib/web",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
