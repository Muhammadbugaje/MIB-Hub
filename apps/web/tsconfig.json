{
  // Astro's strictest preset, plus our shared settings.
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src", "scripts", "test", "astro.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  }
}
