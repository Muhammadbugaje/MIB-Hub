---
/**
 * Sign-in, register and password pages (EE Hub's base_auth.html): an
 * always-dark art panel with the live arcade scene on the left, the form
 * card on the right. On phones the art becomes a short banner on top.
 *
 *   <AuthLayout title="Sign in" headline="Welcome" accent="back." icon="login"> ...form... </AuthLayout>
 */
import "../styles/public.css";
import FxScene from "../components/FxScene.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { repos } from "../lib/db.ts";
import { siteConfig } from "../site.config.ts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  /** The plain part of the big line on the art panel. */
  headline?: string;
  /** The gradient part that follows it. */
  accent?: string;
  /** Icon in the badge above the form heading. */
  icon?: string;
}
const { title, headline = "Every game,", accent = "one account.", icon = "key" } = Astro.props;
const games = await repos.games.listPublic();
---

<BaseLayout title={title} bodyClass="auth pub" motion>
  <div class="auth__art">
    <FxScene kind="arcade" />
    <Logo lockup size={46} />
    <div class="auth__art-copy">
      <p class="auth__kicker"><i aria-hidden="true"></i>{games.length} games, free to play</p>
      <h2 class="auth__headline">{headline} <em>{accent}</em></h2>
      <p class="auth__lead">Your progress, scores and unlocks follow you to every game on {siteConfig.name}, on every device.</p>
      <ul class="auth__perks">
        <li style="--c: #e6c867"><Icon name="cloud" size={16} />Saves that follow you</li>
        <li style="--c: #38e1f5"><Icon name="trophy" size={16} />A place on the leaderboards</li>
        <li style="--c: #a78bfa"><Icon name="shield" size={16} />No adverts, no tracking sold</li>
      </ul>
    </div>
    <button class="pub-calm" type="button" aria-pressed="false" aria-label="Pause motion" data-calm-toggle title="Pause or play the animation">
      <span class="pub-calm__pause"><Icon name="pause" size={14} /><span>Pause motion</span></span>
      <span class="pub-calm__play"><Icon name="play" size={14} /><span>Play motion</span></span>
    </button>
  </div>

  <main class="auth__main" id="main">
    <div class="auth__top">
      <a class="auth__back" href="/"><Icon name="arrow-left" size={16} />Back to {siteConfig.name}</a>
      <ThemeToggle />
    </div>
    <div class="auth__card">
      <div class="auth__badge"><Icon name={icon} size={24} /></div>
      <slot />
    </div>
    <p class="auth__foot">{siteConfig.name} · {siteConfig.footerNote} · <a href="/support">Need help?</a></p>
  </main>
</BaseLayout>
