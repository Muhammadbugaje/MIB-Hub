---
/**
 * /account/security: change password and see / sign out other devices.
 * Both go through Better Auth (auth.api.*), which checks the session.
 */
import AIcon from "../../components/admin/AIcon.astro";
import PageHead from "../../components/admin/PageHead.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { done, fStr, type FormErrors } from "../../lib/admin-kit.ts";
import { MIN_PASSWORD_LENGTH, auth, authErrorMessage } from "../../lib/auth.ts";
import { guard } from "../../lib/guard.ts";
import { deviceOf } from "../../lib/http.ts";
import { timeAgo } from "../../lib/site.ts";

const denied = guard(Astro, { signedIn: true });
if (denied) return denied;

const errors: FormErrors = {};
let formError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = fStr(form, "action", 20);
  if (action === "password") {
    const current = String(form.get("current") ?? "");
    const next = String(form.get("new") ?? "");
    const again = String(form.get("again") ?? "");
    if (!current) errors.current = "Enter your current password.";
    if (next.length < MIN_PASSWORD_LENGTH) errors.new = `Use at least ${MIN_PASSWORD_LENGTH} characters.`;
    else if (next !== again) errors.again = "The two new passwords do not match.";
    if (Object.keys(errors).length === 0) {
      const res = await auth.api.changePassword({
        body: { currentPassword: current, newPassword: next, revokeOtherSessions: true },
        headers: Astro.request.headers,
        asResponse: true,
      });
      if (res.ok) {
        // The response carries the refreshed session cookie; pass it on.
        const r = done(Astro, "Password changed. Your other devices were signed out.");
        for (const c of res.headers.getSetCookie()) r.headers.append("set-cookie", c);
        return r;
      }
      formError = await authErrorMessage(res);
    }
  } else if (action === "others") {
    await auth.api.revokeOtherSessions({ headers: Astro.request.headers });
    return done(Astro, "Signed out of every other device.");
  }
}

const current = Astro.locals.session?.session;
const sessions = (await auth.api.listSessions({ headers: Astro.request.headers })).sort((a, b) => +b.updatedAt - +a.updatedAt);
const browser = (ua: string | null | undefined) => {
  const s = ua ?? "";
  const name = /edg\//i.test(s) ? "Edge" : /chrome\//i.test(s) ? "Chrome" : /firefox\//i.test(s) ? "Firefox" : /safari\//i.test(s) ? "Safari" : /curl/i.test(s) ? "Command line" : "Browser";
  const os = /iphone|ipad/i.test(s) ? "iOS" : /android/i.test(s) ? "Android" : /mac os/i.test(s) ? "macOS" : /windows/i.test(s) ? "Windows" : /linux/i.test(s) ? "Linux" : "";
  return os ? `${name} on ${os}` : name;
};
---

<AppLayout title="Security">
  <PageHead eyebrow="Your account" title="Security" icon="lock" lead="Your password and the devices signed in to your account." />

  <div class="hub-grid hub-grid--2">
    <form class="hub-card" method="post">
      <input type="hidden" name="action" value="password" />
      <div class="hub-card__head">
        <div>
          <h2 class="hub-card__title"><AIcon name="key" size={18} /> Change password</h2>
          <p class="hub-card__sub">Changing it signs out your other devices.</p>
        </div>
      </div>
      {formError && <div class="hub-note hub-note--danger" role="alert" style="margin-bottom: var(--space-4);"><AIcon name="alert" size={16} /> {formError}</div>}
      <div class="hub-fields" style="grid-template-columns: 1fr;">
        <div class="hub-field">
          <label class="hub-field__label" for="s-cur">Current password</label>
          <input class="input" id="s-cur" name="current" type="password" autocomplete="current-password" required aria-invalid={errors.current ? "true" : undefined} />
          {errors.current && <p class="hub-field__error">{errors.current}</p>}
        </div>
        <div class="hub-field">
          <label class="hub-field__label" for="s-new">New password</label>
          <input class="input" id="s-new" name="new" type="password" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} required aria-invalid={errors.new ? "true" : undefined} />
          <p class="hub-field__hint">At least {MIN_PASSWORD_LENGTH} characters. A short sentence is easy to remember and hard to guess.</p>
          {errors.new && <p class="hub-field__error">{errors.new}</p>}
        </div>
        <div class="hub-field">
          <label class="hub-field__label" for="s-again">New password again</label>
          <input class="input" id="s-again" name="again" type="password" autocomplete="new-password" required aria-invalid={errors.again ? "true" : undefined} />
          {errors.again && <p class="hub-field__error">{errors.again}</p>}
        </div>
      </div>
      <div class="hub-btn-row">
        <button class="btn btn--primary" type="submit">Change password</button>
        <a class="btn btn--ghost" href="/auth/forgot-password">Forgot it?</a>
      </div>
    </form>

    <section class="hub-card">
      <div class="hub-card__head">
        <div>
          <h2 class="hub-card__title"><AIcon name="device" size={18} /> Signed-in devices</h2>
          <p class="hub-card__sub">{sessions.length === 1 ? "Only this device." : `${sessions.length} devices.`}</p>
        </div>
      </div>
      <ul class="hub-list">
        {
          sessions.map((s) => {
            const here = s.id === current?.id;
            const kind = deviceOf(s.userAgent ?? null);
            return (
              <li>
                <span class:list={["hub-list__icon", here && "hub-list__icon--volt"]}>
                  <AIcon name={kind === "desktop" ? "monitor" : "device"} size={18} />
                </span>
                <span class="hub-list__body">
                  <span class="hub-list__title">{browser(s.userAgent)}</span>
                  <span class="hub-list__meta">
                    {s.ipAddress || "Unknown address"} · active {timeAgo(new Date(s.updatedAt))}
                  </span>
                </span>
                {here && <span class="hub-pill hub-pill--green">This device</span>}
              </li>
            );
          })
        }
      </ul>
      {
        sessions.length > 1 && (
          <form method="post" class="hub-card__foot" data-confirm="Sign out of every other device?">
            <input type="hidden" name="action" value="others" />
            <button class="btn btn--sm hub-btn-danger" type="submit">
              <AIcon name="logout" size={15} /> Sign out other devices
            </button>
          </form>
        )
      }
    </section>
  </div>
</AppLayout>
