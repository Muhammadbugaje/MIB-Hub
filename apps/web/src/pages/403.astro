---
// Shown (via Astro.rewrite) when a signed-in user lacks a permission. See lib/guard.ts.
import Icon from "../components/Icon.astro";
import PublicLayout from "../layouts/PublicLayout.astro";

Astro.response.status = 403;
const { viewer } = Astro.locals;
---

<PublicLayout title="Not allowed">
  <section class="pub-wrap pub-err">
    <div>
      <p class="pub-err__hud"><span>ACCESS <b>LOCKED</b></span></p>
      <div class="pub-err__code" aria-hidden="true"><i>4</i><i>0</i><i>3</i></div>
      <h1>This page is not for your account</h1>
      <p>
        {
          viewer.user
            ? `You are signed in as ${viewer.user.name}, but your role does not include this page. Ask the site owner if you need access.`
            : "You need the right account to open this page."
        }
      </p>
      <div class="pub-err__cta">
        <a class="pub-btn pub-btn--primary" href={viewer.user ? "/account" : "/auth/sign-in"}>
          <Icon name={viewer.user ? "dashboard" : "login"} size={16} />
          {viewer.user ? "My account" : "Sign in"}
        </a>
        <a class="pub-btn pub-btn--ghost" href="/"><Icon name="home" size={16} />Back home</a>
      </div>
    </div>
  </section>
</PublicLayout>
