---
/**
 * Choose a new password. The emailed link goes to Better Auth
 * (/api/auth/reset-password/<token>), which checks the token and sends the
 * visitor here with ?token=... (or ?error=INVALID_TOKEN).
 */
import Alert from "../../components/Alert.astro";
import Field from "../../components/Field.astro";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { MIN_PASSWORD_LENGTH, auth, authErrorMessage } from "../../lib/auth.ts";

let token = Astro.url.searchParams.get("token") ?? "";
let error = Astro.url.searchParams.get("error") ? "This reset link has expired or was already used. Ask for a new one." : "";
const errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  token = String(form.get("token") ?? "");
  const password = String(form.get("password") ?? "");
  const confirm = String(form.get("confirm") ?? "");
  if (password.length < MIN_PASSWORD_LENGTH) errors.password = `Use at least ${MIN_PASSWORD_LENGTH} characters.`;
  else if (password !== confirm) errors.confirm = "The two passwords do not match.";

  if (!token) error = "This reset link is missing its token. Ask for a new one.";
  else if (Object.keys(errors).length === 0) {
    const res = await auth.api.resetPassword({
      body: { newPassword: password, token },
      headers: Astro.request.headers,
      asResponse: true,
    });
    if (res.ok) return Astro.redirect("/auth/sign-in?reset=done", 303);
    error = await authErrorMessage(res);
  }
  Astro.response.status = 400;
}
---

<AuthLayout title="Choose a new password" headline="A fresh" accent="start." icon="lock">
  <h1>Choose a new password</h1>
  <p class="lead">After this, every device signed in to your account will be signed out.</p>
  {error && <Alert tone="danger">{error} <a href="/auth/forgot-password">Get a new link</a></Alert>}
  {
    token && (
      <form class="form" method="post" novalidate style="margin-top: var(--space-4);">
        <input type="hidden" name="token" value={token} />
        <Field
          name="password"
          label="New password"
          type="password"
          autocomplete="new-password"
          minlength={MIN_PASSWORD_LENGTH}
          hint={`At least ${MIN_PASSWORD_LENGTH} characters.`}
          error={errors.password}
          required
          autofocus
        />
        <Field name="confirm" label="Type it again" type="password" autocomplete="new-password" error={errors.confirm} required />
        <button class="pub-btn pub-btn--gold auth__submit" type="submit">
          Save new password
        </button>
      </form>
    )
  }
</AuthLayout>
