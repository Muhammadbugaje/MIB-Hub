---
/**
 * Ask for a password reset link. We always show the same message, whether
 * or not the email has an account, so this page cannot be used to find out
 * who is registered. The email goes through lib/mailer.ts (printed in the
 * terminal in development).
 */
import Alert from "../../components/Alert.astro";
import Field from "../../components/Field.astro";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { auth } from "../../lib/auth.ts";

let sent = false;
let email = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = String(form.get("email") ?? "").trim();
  if (email) {
    try {
      await auth.api.requestPasswordReset({
        body: { email, redirectTo: new URL("/auth/reset-password", Astro.url).toString() },
        headers: Astro.request.headers,
      });
    } catch (err) {
      // Log, but show the same message as success (see above).
      console.error("[forgot-password]", err);
    }
    sent = true;
  }
}
---

<AuthLayout title="Forgot password" headline="It happens" accent="to everyone." icon="mail">
  <h1>Reset your password</h1>
  <p class="lead">Enter the email you signed up with and we will send you a link to choose a new password.</p>
  {
    sent ? (
      <Alert tone="success">
        If <strong>{email}</strong> has an account, a reset link is on its way. It works for one hour.
      </Alert>
    ) : (
      <form class="form" method="post" novalidate>
        <Field name="email" label="Email" type="email" autocomplete="email" value={email} required autofocus />
        <button class="pub-btn pub-btn--gold auth__submit" type="submit">
          Send reset link
        </button>
      </form>
    )
  }
  <p class="auth__switch">Remembered it? <a href="/auth/sign-in">Back to sign in</a></p>
</AuthLayout>
