---
/**
 * /admin/characters: the open-world cast. Special characters (real people)
 * come first, each with a kill switch ("switch.special.<name>" in site
 * settings, read by specialSwitches()). Then everyone else, filterable by
 * kind and searchable. Needs games.manage_content.
 */
import { CHARACTER_KINDS } from "@mib/db";
import AIcon from "../../../components/admin/AIcon.astro";
import Avatar from "../../../components/admin/Avatar.astro";
import EmptyState from "../../../components/admin/EmptyState.astro";
import PageHead from "../../../components/admin/PageHead.astro";
import ToggleForm from "../../../components/admin/ToggleForm.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import { audit, done, fStr, labelize } from "../../../lib/admin-kit.ts";
import { repos } from "../../../lib/db.ts";
import { guard } from "../../../lib/guard.ts";
import { specialSwitches } from "../../../lib/site.ts";

const denied = guard(Astro, { permission: "games.manage_content" });
if (denied) return denied;

const specialName = (key: string) => key.replace(/^special\./, "");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = fStr(form, "action", 20);
  const key = fStr(form, "id", 80);
  const ch = await repos.characters.getByKey(key);
  if (!ch) return done(Astro, "That character no longer exists.", undefined, "danger");
  const on = fStr(form, "value") === "on";
  if (action === "toggle") {
    await repos.characters.update(key, { enabled: on });
    await audit(Astro, "character.enabled", "character", key, { enabled: ch.enabled }, { enabled: on });
    return done(Astro, `${ch.name} ${on ? "shown" : "hidden"} everywhere.`);
  }
  if (action === "special" && ch.kind === "special") {
    const settingKey = `switch.special.${specialName(key)}`;
    const before = (await specialSwitches())[specialName(key)] ?? true;
    await repos.siteSettings.set(settingKey, on, Astro.locals.viewer.user?.id ?? null);
    await audit(Astro, "setting.update", "site_setting", settingKey, { value: before }, { value: on });
    return done(Astro, `${ch.name}'s scenes ${on ? "switched on" : "switched off"}. The game uses the fallback lines while off.`);
  }
}

const kind = Astro.url.searchParams.get("kind") ?? "";
const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();
const [all, switches] = await Promise.all([repos.characters.listAll(), specialSwitches()]);
const specials = all.filter((c) => c.kind === "special");
let rest = all.filter((c) => c.kind !== "special");
if (kind) rest = rest.filter((c) => c.kind === kind);
if (q) rest = rest.filter((c) => `${c.name} ${c.key} ${c.role} ${c.bio}`.toLowerCase().includes(q));
const counts = new Map<string, number>();
for (const c of all) counts.set(c.kind, (counts.get(c.kind) ?? 0) + 1);
const kinds = CHARACTER_KINDS.filter((k) => k !== "special" && counts.get(k));
---

<AppLayout title="Characters">
  <PageHead eyebrow="Games" title="Characters" icon="mask" lead={`The open-world cast: ${all.length} characters. Hide one with its switch; edit bios, voices, powers, unlocks and portraits.`} />

  {
    specials.length > 0 && (
      <section class="hub-card" style="margin-bottom: var(--space-5);">
        <div class="hub-card__head">
          <div>
            <h2 class="hub-card__title"><AIcon name="star" size={18} /> Special characters</h2>
            <p class="hub-card__sub">Based on real people. Each appears only in its own scenes, with fallback lines when switched off.</p>
          </div>
        </div>
        <div class="hub-note hub-note--warn" style="margin-bottom: var(--space-4);">
          <AIcon name="alert" size={16} />
          <span>Keep a special character off until the real person has signed their consent and approved their look and lines. Mark that on their page (“Approved”). The public trailer never uses them.</span>
        </div>
        <div class="hub-cards">
          {specials.map((c) => {
            const on = switches[specialName(c.key)] ?? true;
            return (
              <article class:list={["hub-mcard", !on && "is-off"]}>
                <div class="hub-mcard__body" style="grid-template-columns: auto 1fr; align-items:center; column-gap: var(--space-3);">
                  <Avatar name={c.name} src={c.portraitUrl || null} size={52} />
                  <div style="min-width:0;">
                    <h3 class="hub-mcard__title">{c.name}</h3>
                    <p class="hub-mcard__text">{c.role || "Special character"}</p>
                  </div>
                </div>
                <div class="hub-mcard__foot">
                  <ToggleForm id={c.key} action="special" checked={on} label={`${c.name}'s scenes on`} />
                  <span class="hub-subtle">{on ? "Scenes on" : "Off (fallbacks)"}</span>
                  {c.approved ? <span class="hub-pill hub-pill--green">Approved</span> : <span class="hub-pill hub-pill--gold">Not approved</span>}
                  <a class="btn btn--sm hub-push" href={`/admin/characters/${encodeURIComponent(c.key)}`}>
                    <AIcon name="edit" size={15} /> Edit
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  <form class="hub-toolbar" method="get">
    <nav class="hub-tabs" aria-label="Filter by kind">
      <a href={q ? `?q=${encodeURIComponent(q)}` : "/admin/characters"} aria-current={!kind ? "page" : undefined}>All <span class="hub-tabs__n">{all.length - specials.length}</span></a>
      {kinds.map((k) => (
        <a href={`?kind=${k}${q ? `&q=${encodeURIComponent(q)}` : ""}`} aria-current={kind === k ? "page" : undefined}>{labelize(k)} <span class="hub-tabs__n">{counts.get(k)}</span></a>
      ))}
    </nav>
    {kind && <input type="hidden" name="kind" value={kind} />}
    <input class="input hub-toolbar__grow" type="search" name="q" value={q} placeholder="Search name, role or bio" aria-label="Search characters" />
  </form>

  <section class="hub-card hub-card--flush">
    {
      rest.length === 0 ? (
        <EmptyState icon="mask" title="No character matches" text="Try another word or choose All." />
      ) : (
        <div class="hub-table-wrap">
          <table class="hub-table hub-table--stack">
            <thead>
              <tr>
                <th>Character</th>
                <th>Kind</th>
                <th>Playable</th>
                <th class="hub-num">Voice lines</th>
                <th>Shown</th>
                <th />
              </tr>
            </thead>
            <tbody>
              {rest.map((c) => (
                <tr class:list={[!c.enabled && "is-off"]}>
                  <td>
                    <span style="display:flex; align-items:center; gap: 12px;">
                      <Avatar name={c.name} src={c.portraitUrl || null} size={36} />
                      <span style="min-width:0;">
                        <a class="hub-row-title" href={`/admin/characters/${encodeURIComponent(c.key)}`}>{c.name}</a>
                        <span class="hub-row-sub">{c.role || c.key}</span>
                      </span>
                    </span>
                  </td>
                  <td data-label="Kind"><span class="hub-pill hub-pill--plain">{labelize(c.kind)}</span></td>
                  <td data-label="Playable">{c.playable ? <span class="hub-pill hub-pill--volt">{c.power || "Yes"}</span> : <span class="hub-subtle">No</span>}</td>
                  <td class="hub-num" data-label="Lines">{c.lineCount.toLocaleString("en-GB")}</td>
                  <td data-label="Shown"><ToggleForm id={c.key} action="toggle" checked={c.enabled} label={`${c.name} shown`} /></td>
                  <td class="hub-actions-cell"><a class="btn btn--sm btn--ghost" href={`/admin/characters/${encodeURIComponent(c.key)}`}><AIcon name="edit" size={15} /> Edit</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</AppLayout>
