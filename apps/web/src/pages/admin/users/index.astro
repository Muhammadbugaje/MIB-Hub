---
/**
 * /admin/users: every account, searchable, filterable by role and banned.
 * Needs users.view; changes happen on each user's page.
 */
import AIcon from "../../../components/admin/AIcon.astro";
import Avatar from "../../../components/admin/Avatar.astro";
import EmptyState from "../../../components/admin/EmptyState.astro";
import PageHead from "../../../components/admin/PageHead.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import { labelize } from "../../../lib/admin-kit.ts";
import { repos } from "../../../lib/db.ts";
import { guard } from "../../../lib/guard.ts";
import { ROLES } from "../../../lib/permissions.ts";
import { formatDate } from "../../../lib/site.ts";

const denied = guard(Astro, { permission: "users.view" });
if (denied) return denied;

const PER = 30;
const sp = Astro.url.searchParams;
const q = sp.get("q") ?? "";
const role = sp.get("role") ?? "";
const banned = sp.get("banned") === "1" ? true : undefined;
const page = Math.max(1, Number(sp.get("page")) || 1);
const [{ rows, total }, everyone] = await Promise.all([
  repos.users.search({ q, role: role || undefined, banned, limit: PER, offset: (page - 1) * PER }),
  repos.users.count(),
]);
const pages = Math.max(1, Math.ceil(total / PER));
const link = (p: number) => {
  const u = new URLSearchParams(sp);
  u.set("page", String(p));
  return `?${u}`;
};
const roleTone: Record<string, string> = { owner: "hub-pill hub-pill--gold", admin: "hub-pill hub-pill--green", moderator: "hub-pill hub-pill--blue" };
---

<AppLayout title="Users & roles">
  <PageHead eyebrow="Players" title="Users & roles" icon="user-cog" lead={`${everyone} accounts. Open one to change its role, ban it, or grant a single permission.`} />

  <form method="get" class="hub-toolbar">
    <input class="input hub-toolbar__grow" type="search" name="q" value={q} placeholder="Search name or email" aria-label="Search users" />
    <select class="input" name="role" aria-label="Role" style="width:auto;">
      <option value="">Every role</option>
      {ROLES.filter((r) => r !== "guest").map((r) => <option value={r} selected={r === role}>{labelize(r)}</option>)}
    </select>
    <label class="hub-check"><input type="checkbox" name="banned" value="1" checked={banned} /> Banned only</label>
    <button class="btn" type="submit"><AIcon name="search" size={15} /> Search</button>
  </form>

  <section class="hub-card hub-card--flush">
    {
      rows.length === 0 ? (
        <EmptyState icon="users" title="No account matches" text="Try part of a name or an email address, or clear the filters." />
      ) : (
        <div class="hub-table-wrap">
          <table class="hub-table hub-table--stack">
            <thead><tr><th>Account</th><th>Role</th><th>Joined</th><th>Status</th><th /></tr></thead>
            <tbody>
              {rows.map((u) => (
                <tr class:list={[u.banned && "is-off"]}>
                  <td>
                    <span style="display:flex; gap: 12px; align-items:center;">
                      <Avatar name={u.name} src={u.image} size={36} />
                      <span style="min-width:0;">
                        <a class="hub-row-title" href={`/admin/users/${u.id}`}>{u.name}</a>
                        <span class="hub-row-sub">{u.email}</span>
                      </span>
                    </span>
                  </td>
                  <td data-label="Role"><span class={roleTone[u.role] ?? "hub-pill"}>{labelize(u.role)}</span></td>
                  <td data-label="Joined">{formatDate(u.createdAt)}</td>
                  <td data-label="Status">{u.banned ? <span class="hub-pill hub-pill--red">Banned</span> : u.emailVerified ? <span class="hub-pill hub-pill--green">Verified</span> : <span class="hub-pill">Active</span>}</td>
                  <td class="hub-actions-cell"><a class="btn btn--sm" href={`/admin/users/${u.id}`}>Open</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    {
      pages > 1 && (
        <div class="hub-pager">
          {page > 1 ? <a class="btn btn--sm" href={link(page - 1)}><AIcon name="arrow-left" size={14} /> Newer</a> : <span />}
          <span>Page {page} of {pages} · {total} accounts</span>
          {page < pages ? <a class="btn btn--sm" href={link(page + 1)}>Older <AIcon name="arrow-right" size={14} /></a> : <span />}
        </div>
      )
    }
  </section>
</AppLayout>
