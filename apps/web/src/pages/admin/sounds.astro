---
/**
 * /admin/sounds: the sound manager's front page. Every game with how many
 * sounds it makes and how many have a custom replacement, linking to
 * /admin/games/<slug>/sounds, plus every custom sound players hear now.
 * (?game=<slug> goes straight to that game's sounds.) Needs games.manage_sounds.
 */
import AIcon from "../../components/admin/AIcon.astro";
import EmptyState from "../../components/admin/EmptyState.astro";
import PageHead from "../../components/admin/PageHead.astro";
import { soundEntry, soundInventory } from "../../games/sounds/index.ts";
import AppLayout from "../../layouts/AppLayout.astro";
import { labelize } from "../../lib/admin-kit.ts";
import { repos } from "../../lib/db.ts";
import { guard } from "../../lib/guard.ts";
import { timeAgo } from "../../lib/site.ts";

const denied = guard(Astro, { permission: "games.manage_sounds" });
if (denied) return denied;

const jump = Astro.url.searchParams.get("game");
if (jump && /^[a-z0-9-]{1,80}$/.test(jump)) return Astro.redirect(`/admin/games/${jump}/sounds`);

const games = await repos.games.listAll();
const custom = await repos.sounds.list();
const title = new Map(games.map((g) => [g.slug, g.title]));
const rows = games
  .map((g) => ({ g, total: soundInventory(g.slug)?.sounds.length ?? 0, custom: custom.filter((s) => s.gameSlug === g.slug).length }))
  .sort((a, b) => b.total - a.total || a.g.title.localeCompare(b.g.title));
const kb = (n: number) => `${Math.max(1, Math.round(n / 1024))} KB`;
const totalSounds = rows.reduce((n, r) => n + r.total, 0);
---

<AppLayout title="Sounds">
  <PageHead eyebrow="Games" title="Sounds" icon="music" lead="Every game's sounds and where they are heard. Pick a game to listen to its sounds and replace any of them with an upload, a recording or an edit." />

  <div class="hub-stats snd-stats">
    <div class="hub-stat hub-stat--volt"><div class="hub-stat__top">Sounds in all games <AIcon name="wave" size={18} /></div><div class="hub-stat__value">{totalSounds}</div></div>
    <div class="hub-stat hub-stat--gold"><div class="hub-stat__top">Custom now <AIcon name="music" size={18} /></div><div class="hub-stat__value">{custom.length}</div></div>
  </div>

  <div class="hub-grid hub-grid--side">
    <section class="hub-card hub-card--flush">
      <div class="hub-card__head"><h2 class="hub-card__title"><AIcon name="gamepad" size={18} /> Games</h2></div>
      <ul class="hub-list snd-list">
        {
          rows.map(({ g, total, custom: n }) => (
            <li>
              <span class="hub-list__icon hub-list__icon--volt"><AIcon name="music" size={16} /></span>
              <span class="hub-list__body">
                <a class="hub-list__title" href={`/admin/games/${g.slug}/sounds`}>{g.title}</a>
                <span class="hub-list__meta">{total ? `${total} sounds` : "No sound list yet"}{n > 0 && ` · ${n} custom`}</span>
              </span>
              <a class="btn btn--sm" href={`/admin/games/${g.slug}/sounds`} aria-label={`Open ${g.title} sounds`}>Open</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-card hub-card--flush">
      <div class="hub-card__head"><h2 class="hub-card__title"><AIcon name="wave" size={18} /> Custom sounds players hear now</h2></div>
      {
        custom.length === 0 ? (
          <EmptyState icon="music" title="No custom sounds" text="Every game plays its own sounds. Open a game to replace one." />
        ) : (
          <ul class="hub-list snd-list">
            {custom.map((s) => (
              <li style="flex-wrap: wrap;">
                <span class="hub-list__icon hub-list__icon--gold"><AIcon name="wave" size={18} /></span>
                <span class="hub-list__body">
                  <a class="hub-list__title" href={`/admin/games/${s.gameSlug}/sounds/${encodeURIComponent(s.name)}`}>
                    {soundEntry(s.gameSlug, s.name)?.name ?? s.name} · {title.get(s.gameSlug) ?? labelize(s.gameSlug)}
                  </a>
                  <span class="hub-list__meta">
                    <span class="hub-code">{s.name}</span> · v{s.version} · {s.duration.toFixed(2)} s · {kb(s.size)} · {timeAgo(s.updatedAt)}
                  </span>
                </span>
                <audio controls preload="none" src={`/api/admin/sound/${s.id}?v=${s.version}`} class="snd-audio"></audio>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</AppLayout>

<style>
  .snd-stats { margin-bottom: var(--space-5); }
  .snd-list { padding: 0 var(--space-5); }
  .snd-audio { height: 34px; max-width: 220px; }
</style>
