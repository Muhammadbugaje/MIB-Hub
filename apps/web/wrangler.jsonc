// Cloudflare Workers settings for the MIB-Hub website.
// How to deploy: docs/DEPLOY_CLOUDFLARE.md (and .pdf).
//
// Two values below are yours to paste in once (search for "PASTE"):
//   1. database_id  from `npx wrangler d1 create mib-hub`
//   2. SITE_URL     the address the site is served at
// Secrets (BETTER_AUTH_SECRET...) never go in this file: use `npx wrangler secret put`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mib-hub",
  // The Worker that `npm run build` makes.
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-01-01",
  // Node.js APIs on Workers (AsyncLocalStorage, Buffer... used by libraries).
  // Password hashing does NOT use them: it is Web Crypto PBKDF2 (src/lib/passwords.ts).
  "compatibility_flags": ["nodejs_compat"],
  // Pictures, scripts, styles and the games' files, served straight from Cloudflare.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // The database (Cloudflare D1, hosted SQLite). Tables come from packages/db/migrations.
  // Uploaded images and sounds live in it too (the `blob` table): no R2 bucket,
  // so the site runs on the Workers Free plan with no payment card.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mib-hub",
      "database_id": "fa599c3d-a84e-4184-9b56-d9e19c7974b1",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // Plain settings (not secret).
  "vars": {
    "SITE_URL": "https://mib-hub.muhammad-iliyasu2348.workers.dev",
    "MAIL_DRIVER": "console",
    "MAIL_FROM": "MIB-Hub <no-reply@example.com>",
  },
  // Keeps the Worker's logs in the Cloudflare dashboard (Workers > mib-hub > Logs).
  "observability": {
    "enabled": true,
  },
}
